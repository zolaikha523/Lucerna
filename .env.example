# ---------------------------------------------------------------------------
# Lucerna configuration. Copy this file to ".env" (setup_windows.bat does it for you)
# and edit. Restart Lucerna after changing it.
# Relative paths are relative to the Lucerna folder. Absolute paths are allowed.
# ---------------------------------------------------------------------------

# ---- Storage --------------------------------------------------------------
# Recommended on Windows: keep data on the D: drive (and turn on BitLocker for it).
# Uncomment and adjust, e.g.:
# LUCERNA_DATA_DIR=D:\LucernaData
# LUCERNA_DB=D:\LucernaData\lucerna.sqlite3
# LUCERNA_UPLOAD_DIR=D:\LucernaData\uploads
# LUCERNA_ANALYTIC_DIR=D:\LucernaData\analytic
# LUCERNA_REPORT_DIR=D:\LucernaData\outputs
# LUCERNA_LOG_DIR=D:\LucernaData\logs
# LUCERNA_TEMP_DIR=D:\LucernaData\tmp
# LUCERNA_BACKUP_DIR=E:\LucernaBackups
LUCERNA_DATA_DIR=data
LUCERNA_DB=data/lucerna.sqlite3
LUCERNA_UPLOAD_DIR=data/uploads
LUCERNA_ANALYTIC_DIR=data/analytic
LUCERNA_REPORT_DIR=data/outputs
LUCERNA_LOG_DIR=data/logs
LUCERNA_TEMP_DIR=data/tmp
LUCERNA_BACKUP_DIR=data/backups

# ---- Limits and security --------------------------------------------------
LUCERNA_MAX_UPLOAD_MB=200
LUCERNA_SESSION_HOURS=8
LUCERNA_LOGIN_MAX_FAILURES=5
LUCERNA_LOGIN_LOCK_MINUTES=15
LUCERNA_JOB_WORKERS=2

# ---- Local AI (Ollama) ----------------------------------------------------
# Content stays on this computer. Install Ollama, then:  ollama pull gemma3:4b
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma3:4b
# Leave empty to let Ollama decide; 0 forces CPU only (use if the GPU runs out of memory).
OLLAMA_NUM_GPU=
OLLAMA_TIMEOUT_SECONDS=180
LLM_JSON_RETRIES=2
MAX_SEGMENTS_PER_LLM_BATCH=1
LLM_NUM_PREDICT=2048

# ---- External AI (off) ----------------------------------------------------
# External/cloud providers are blocked unless this is 1 AND the administrator enables
# external AI in Privacy & System AND approves the provider after a terms review.
# Restricted projects are always blocked. API keys are read from environment variables
# you name in AI & Models; never put a key in the database.
LUCERNA_EXTERNAL_AI_ENABLED=0
